rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function accountIsDeleting(userId) {
      return firestore.exists(
        /databases/(default)/documents/accountDeletionJobs/$(userId)
      ) || (firestore.exists(
        /databases/(default)/documents/users/$(userId)
      ) && firestore.get(
        /databases/(default)/documents/users/$(userId)
      ).data.get('deletionInProgress', false) == true);
    }

    function canWriteAccount(userId) {
      return isOwner(userId) && !accountIsDeleting(userId);
    }

    function isBusinessDocument() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/jpeg|image/png|image/webp'
        );
    }

    function isPdf() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    function isCompanyLogo() {
      return request.resource != null
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }

    match /users/{userId}/attachments/bills/{billId}/{fileName} {
      allow get: if isOwner(userId);
      allow delete: if canWriteAccount(userId);
      allow create, update: if canWriteAccount(userId)
        && isBusinessDocument();
    }

    match /users/{userId}/attachments/expenses/{expenseId}/{fileName} {
      allow get: if isOwner(userId);
      allow delete: if canWriteAccount(userId);
      allow create, update: if canWriteAccount(userId)
        && isBusinessDocument();
    }

    match /users/{userId}/attachments/clients/{clientId}/{fileName} {
      allow get: if isOwner(userId);
      allow delete: if canWriteAccount(userId);
      allow create, update: if canWriteAccount(userId) && isPdf();
    }

    match /users/{userId}/branding/company-logo {
      allow get: if isOwner(userId);
      allow delete: if canWriteAccount(userId);
      allow create, update: if canWriteAccount(userId) && isCompanyLogo();
    }
  }
}
