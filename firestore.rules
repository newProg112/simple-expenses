rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function accountIsDeleting(uid) {
      return exists(
        /databases/$(database)/documents/accountDeletionJobs/$(uid)
      ) || (
        exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid))
          .data.get('deletionInProgress', false) == true
      );
    }

    function canWriteAccount(uid) {
      return isOwner(uid) && !accountIsDeleting(uid);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if canWriteAccount(uid)
        && !request.resource.data.keys().hasAny([
          'deletionInProgress',
          'accountDeletionState',
          'deletionRequestedAt',
          'deletionProtected'
        ]);
      // Shared demo business/account settings are immutable to the demo user.
      // Nested transactional collections retain the separate owner rule below.
      allow update: if canWriteAccount(uid)
        && resource.data.demoMode != true
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'deletionInProgress',
          'accountDeletionState',
          'deletionRequestedAt',
          'deletionProtected'
        ]);
      allow delete: if canWriteAccount(uid) && resource.data.demoMode != true;
    }

    // Server-owned job state. Customers use requestAccountDeletion rather
    // than reading or mutating orchestration internals directly.
    match /accountDeletionJobs/{uid} {
      allow read, write: if false;
    }

    // Registry claims are owner-readable for diagnostics; all coordination
    // writes and internal idempotency markers remain Admin SDK only.
    match /users/{uid}/referenceKeys/{key} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid}/referenceCreateRequests/{requestId} {
      allow read, write: if false;
    }

    match /users/{uid}/referenceEditRequests/{requestId} {
      allow read, write: if false;
    }

    match /users/{uid}/referenceDeleteRequests/{requestId} {
      allow read, write: if false;
    }

    match /users/{uid}/referenceBackfillMigrations/{migrationId} {
      allow read, write: if false;
    }

    match /users/{uid}/invoices/{invoiceId} {
      allow read: if isOwner(uid);
      allow create, delete: if false;
      allow update: if canWriteAccount(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'paidAt', 'bankSettlement', 'updatedAt']);
    }

    match /users/{uid}/bills/{billId} {
      allow read: if isOwner(uid);
      allow create, delete: if false;
      allow update: if canWriteAccount(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paidAt', 'bankSettlement', 'updatedAt',
          'attachmentName', 'attachmentUrl', 'attachmentPath',
          'attachmentSize', 'attachmentType'
        ]);
    }

    match /users/{uid}/{collectionName}/{document=**} {
      allow read: if isOwner(uid)
        && collectionName != 'invoices'
        && collectionName != 'bills'
        && collectionName != 'referenceKeys'
        && collectionName != 'referenceCreateRequests'
        && collectionName != 'referenceEditRequests'
        && collectionName != 'referenceDeleteRequests'
        && collectionName != 'referenceBackfillMigrations';
      allow write: if canWriteAccount(uid)
        && collectionName != 'invoices'
        && collectionName != 'bills'
        && collectionName != 'referenceKeys'
        && collectionName != 'referenceCreateRequests'
        && collectionName != 'referenceEditRequests'
        && collectionName != 'referenceDeleteRequests'
        && collectionName != 'referenceBackfillMigrations';
    }

    match /userProfiles/{uid} {
      allow read: if isOwner(uid);
    }

    // Private support notes are available only through admin-authorised callables.
    match /adminUserNotes/{uid} {
      allow read, write: if false;
    }

    match /demoAnalyticsEvents/{eventId} {
      allow create: if isSignedIn()
        && !accountIsDeleting(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'timestamp',
          'uid',
          'eventName',
          'page',
          'userAgent'
        ])
        && request.resource.data.timestamp == request.time
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventName in [
          'Login',
          'Logout',
          'Dashboard viewed',
          'Invoices page viewed',
          'Clients page viewed',
          'Bills page viewed',
          'Expenses page viewed',
          'Projects page viewed',
          'Budgets page viewed',
          'Cashflow page viewed',
          'Trial Balance viewed',
          'General Ledger viewed',
          'Profit & Loss viewed',
          'Balance Sheet viewed'
        ]
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 256
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 512
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.demoMode == true;
      allow read, update, delete: if false;
    }

    match /journals/{journalId} {
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/journals/$(journalId))
          || resource.data.userId == request.auth.uid
        );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && !accountIsDeleting(request.auth.uid)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && !accountIsDeleting(request.auth.uid)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && !accountIsDeleting(request.auth.uid)
        && resource.data.userId == request.auth.uid;
    }
  }
}
